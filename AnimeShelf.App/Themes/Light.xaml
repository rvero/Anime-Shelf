 <SolidColorBrush x:Key="OverlayBrush" Color="#B8000000"/>
 <Style TargetType="{x:Type ProgressBar}"><Setter Property="Foreground" Value="{DynamicResource ActionBrush}"/></Style>
</ResourceDictionary>


