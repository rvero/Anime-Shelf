<Window x:Class="AnimeShelf.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource L_Settings}" Width="600" Height="690" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
 <DockPanel Margin="14"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="{DynamicResource L_InterfaceLanguage}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="InterfaceLanguage" Width="160"><ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Español" Tag="es"/></ComboBox></StackPanel><TextBlock Text="{DynamicResource L_LibraryFolders}" FontWeight="Bold" DockPanel.Dock="Top"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button Content="{DynamicResource L_RemoveFolder}" Click="Remove_Click" Padding="8,4"/><Button Content="{DynamicResource L_OpenCoversSettings}" Click="OpenCovers_Click" Padding="8,4" Margin="8,0,0,0"/><Button Content="{DynamicResource L_Close}" Click="Close_Click" Padding="8,4" Margin="8,0,0,0"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><CheckBox x:Name="CacheCovers" Content="{DynamicResource L_CacheCovers}" Margin="0,12,0,5"/><TextBlock Text="{DynamicResource L_CacheHelp}" TextWrapping="Wrap" Margin="0,0,0,5"/><CheckBox x:Name="TranslateEnabled" Content="{DynamicResource L_EnableTranslation}" Margin="0,12,0,5"/><TextBlock Text="{DynamicResource L_ServerUrl}"/><TextBox x:Name="Endpoint" Margin="0,3,0,5"/><TextBlock Text="{DynamicResource L_TargetLanguage}"/><TextBox x:Name="TargetLanguage" Margin="0,3,0,5"/><TextBlock Text="{DynamicResource L_ApiKey}"/><TextBox x:Name="ApiKey" Margin="0,3,0,5"/><CheckBox x:Name="Mark" Content="{DynamicResource L_MarkOnOpen}" Margin="0,12,0,5"/><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource L_ClearCovers}" Click="ClearCovers_Click" Padding="8,4"/><Button Content="{DynamicResource L_Redownload}" Click="Redownload_Click" Padding="8,4" Margin="8,0,0,0"/></StackPanel><Button Content="{DynamicResource L_RestoreIgnored}" Click="Restore_Click" HorizontalAlignment="Left" Padding="8,4"/></StackPanel><ListBox x:Name="Roots" Margin="0,8,0,0"/></DockPanel>
</Window>






