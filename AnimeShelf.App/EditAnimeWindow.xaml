<Window x:Class="AnimeShelf.EditAnimeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource L_EditAnime}" Width="650" Height="600" MinWidth="460" MinHeight="420" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
 <DockPanel Margin="18"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="{DynamicResource L_CancelEdit}" Click="Cancel_Click" Margin="0,0,8,0"/><Button Content="{DynamicResource L_SaveEdit}" Click="Save_Click"/></StackPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="{DynamicResource L_EditTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="TitleBox" Padding="8" Margin="0,0,0,14"/><TextBlock Text="{DynamicResource L_EditSynopsis}" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="SynopsisBox" Height="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" Margin="0,0,0,14"/><TextBlock Text="{DynamicResource L_EditCover}" FontWeight="SemiBold" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource BackgroundBrush}" Width="90" Height="130" Margin="0,0,14,0"><Image x:Name="Preview" Stretch="Uniform"/></Border><StackPanel><Button Content="{DynamicResource L_ChooseImage}" Click="Choose_Click" Margin="0,0,0,8"/><Button Content="{DynamicResource L_ResetCover}" Click="ResetCover_Click"/><TextBlock x:Name="CoverInfo" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Width="380" Margin="0,8,0,0"/></StackPanel></StackPanel><TextBlock Text="{DynamicResource L_EditHint}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0"/></StackPanel></ScrollViewer>
 </DockPanel>
</Window>
