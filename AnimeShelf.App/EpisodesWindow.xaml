<Window x:Class="AnimeShelf.EpisodesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource L_AnimeDetails}" Width="720" Height="620" MinWidth="450" MinHeight="400" MaxWidth="900" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
 <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource SurfaceBrush}">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="✕" ToolTip="{DynamicResource L_Close}" Padding="9,4" Click="Close_Click"/><TextBlock Text="{DynamicResource L_AnimeDetailsHeading}" Foreground="{DynamicResource ActionBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/></DockPanel>
   <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Height="216" Margin="0,0,20,0"><Grid><TextBlock Text="{DynamicResource L_NoCover}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="CoverImage" Stretch="UniformToFill"/></Grid></Border><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Grid.Row="1" x:Name="Genres" TextWrapping="Wrap" Foreground="{DynamicResource ActionBrush}" Margin="0,0,0,10"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="Synopsis" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="14" LineHeight="21"/></ScrollViewer></Grid></Grid>
   <DockPanel Grid.Row="2" Margin="0,0,0,8"><TextBlock Text="{DynamicResource L_Episodes}" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="Status" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
   <ListBox Grid.Row="3" x:Name="List" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" PreviewMouseWheel="EpisodeWheel" MouseDoubleClick="Play_Click"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,3"><DockPanel><CheckBox DockPanel.Dock="Right" IsChecked="{Binding Watched, Mode=TwoWay}" Content="{DynamicResource L_Watched}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/><Button DockPanel.Dock="Right" Content="▶" ToolTip="{DynamicResource L_PlayEpisode}" Padding="8,3" Click="PlayButton_Click"/><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
   <Button Grid.Row="4" Content="{DynamicResource L_PlayNext}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,8" Click="Next_Click"/>
  </Grid>
 </Border>
</Window>

